{
  "name": "jen-island",
  "version": "5.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8765",
    "check": "for f in $(find js -name '*.js'); do node --check $f || exit 1; done",
    "deploy": "npx wrangler deploy",
    "test": "node tests/run.mjs",
    "test:story": "node tests/run.mjs story",
    "test:render": "node tests/run.mjs render",
    "test:economy": "node tests/run.mjs economy",
    "test:quests": "node tests/run.mjs quests",
    "test:world": "node tests/run.mjs world",
    "test:stability": "node tests/run.mjs stability",
    "test:chaos": "node tests/run.mjs chaos",
    "test:clock": "node tests/run.mjs clock",
    "check:launch": "node tests/launch-check.mjs",
    "deploy:launch": "node tests/launch-check.mjs && npx wrangler deploy",
    "test:quick": "eslint js sw.js && node tests/parallel.mjs quick",
    "test:ui": "node tests/run.mjs ui",
    "sw": "node tools/sw-shell.mjs",
    "app": "node tools/app-web.mjs && npx cap sync",
    "test:features": "node tests/run.mjs features",
    "lint": "eslint js sw.js",
    "check:audio": "node tools/audio-check.mjs",
    "test:all": "eslint js sw.js && node tests/parallel.mjs all"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capawesome/capacitor-app-review": "^7.0.1",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "cordova-plugin-applovin-max": "^2.1.0"
  }
}
